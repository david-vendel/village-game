{
  "name": "village-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.game.json && tsc --noEmit -p tsconfig.tools.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "assets:check": "tsx tools/assets/check.ts",
    "assets:export": "tsx tools/assets/export.ts",
    "art:render": "tsx tools/art-pipeline/run.ts",
    "art:test": "python -m unittest discover -s tools/art-pipeline/tests"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "ajv": "^8.20.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
