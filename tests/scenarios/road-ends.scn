# A road runs on past a street's last plot. A new street never runs over
# another road's end without a crossroads: it ends short of it instead.
new empty
free on
construction off
build crossroads at s0:31
ride #last
turn up
ride +30
build crossroads here
ride #last
turn up
ride +30
build crossroads here
# the third street runs south at column 2, past the main street's west end
streets
map AH0:-F40

# The rocks lie inside squares of the road grid: a street running past them
# runs on beside them.
new empty
free on
construction off
build crossroads at s0:61
build crossroads at s0:91
streets
map O55:-C95
